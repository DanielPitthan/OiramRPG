/* Estilos da UI do OiramRPG (UI Toolkit). Cores de raridade em .rarity-*. */

.oiram-root {
    font-size: 24px;
    color: rgb(245, 245, 245);
}

.text {
    color: rgb(245, 245, 245);
    -unity-text-outline-width: 0.6px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
    white-space: normal;
}

.muted { color: rgba(255, 255, 255, 0.55); }
.good { color: rgb(110, 230, 120); }
.bad { color: rgb(255, 110, 100); }
.gold-text { color: rgb(255, 214, 90); }
.energy-text { color: rgb(120, 190, 255); }
.small { font-size: 19px; }
.big { font-size: 34px; -unity-font-style: bold; }
.huge { font-size: 64px; -unity-font-style: bold; -unity-text-outline-width: 2px; }

.panel {
    background-color: rgba(18, 20, 40, 0.88);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.85);
    border-radius: 14px;
    padding: 12px 16px;
}

.panel-light {
    background-color: rgba(30, 34, 64, 0.82);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.35);
    border-radius: 10px;
    padding: 8px 12px;
}

.row { flex-direction: row; align-items: center; }
.grow { flex-grow: 1; }

/* ---------- Raridades ---------- */
.rarity-common { color: rgb(225, 225, 225); }
.rarity-uncommon { color: rgb(95, 220, 95); }
.rarity-rare { color: rgb(80, 150, 255); }
.rarity-epic { color: rgb(190, 110, 255); }
.rarity-legendary { color: rgb(255, 160, 40); }
.rarity-relic { color: rgb(70, 240, 225); -unity-font-style: bold; }

/* ---------- Menus ---------- */
.menu { min-width: 260px; }
.menu-scroll { max-height: 640px; }
.menu-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 3px 12px;
    margin: 1px 0;
    border-radius: 8px;
}
.menu-item.selected { background-color: rgba(255, 205, 70, 0.95); }
.menu-item.selected > .text { color: rgb(35, 22, 8); -unity-text-outline-width: 0; }
.menu-item.disabled > .text { color: rgba(255, 255, 255, 0.33); }
.menu-item.selected.disabled > .text { color: rgba(35, 22, 8, 0.45); }
.menu-text { font-size: 26px; flex-shrink: 1; }
.menu-right { font-size: 22px; margin-left: 18px; flex-shrink: 0; }

/* ---------- Barras ---------- */
.bar {
    height: 12px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 6px;
    overflow: hidden;
    margin: 3px 0;
}
.bar-fill { height: 100%; width: 100%; background-color: rgb(90, 220, 110); border-radius: 6px; }
.bar-fill.low { background-color: rgb(240, 90, 80); }
.bar-xp { height: 100%; background-color: rgb(120, 180, 255); border-radius: 6px; }
.bar-charge { height: 100%; background-color: rgb(255, 200, 60); border-radius: 6px; }
.bar-charge.full { background-color: rgb(255, 255, 255); }

/* ---------- Transições ---------- */
.fader {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(8, 8, 16);
}

/* ---------- Batalha ---------- */
.turn-strip {
    position: absolute;
    top: 18px;
    left: 0; right: 0;
    flex-direction: row;
    justify-content: center;
}
.turn-chip {
    font-size: 20px;
    padding: 3px 12px;
    margin: 0 4px;
    border-radius: 12px;
    background-color: rgba(18, 20, 40, 0.75);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
}
.turn-chip.party { border-color: rgb(110, 190, 255); }
.turn-chip.enemy { border-color: rgb(255, 120, 110); }
.turn-chip.current { background-color: rgba(255, 205, 70, 0.95); color: rgb(35, 22, 8); -unity-text-outline-width: 0; }
.turn-chip.done { opacity: 0.35; }

.banner {
    position: absolute;
    top: 74px;
    left: 0; right: 0;
    -unity-text-align: middle-center;
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1.5px;
}

.target-info {
    position: absolute;
    top: 128px;
    left: 0; right: 0;
    -unity-text-align: middle-center;
    font-size: 26px;
}

.party-panel {
    position: absolute;
    bottom: 18px;
    right: 24px;
    flex-direction: row;
    align-items: flex-end;
}
.party-card { width: 270px; margin-left: 10px; }
.party-card.active { border-color: rgb(255, 205, 70); }
.party-card.fallen { opacity: 0.55; }
.energy-box { margin-left: 10px; align-items: center; }

.command-panel {
    position: absolute;
    left: 24px;
    bottom: 18px;
    flex-direction: row;
    align-items: flex-end;
}
.description {
    max-width: 520px;
    margin-left: 12px;
}

.popup {
    position: absolute;
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
    width: 400px;
    margin-left: -200px;
}
.popup.damage { color: rgb(255, 255, 255); }
.popup.heal { color: rgb(110, 255, 130); }
.popup.timing { color: rgb(255, 215, 60); font-size: 36px; }
.popup.status { color: rgb(255, 160, 90); font-size: 28px; }
.popup.loot { font-size: 26px; }

.enemy-tag {
    position: absolute;
    width: 260px;
    margin-left: -130px;
    align-items: center;
}
.enemy-tag .bar { width: 120px; height: 8px; }

.charge {
    position: absolute;
    bottom: 230px;
    left: 0; right: 0;
    align-items: center;
}
.charge .bar { width: 420px; height: 22px; border-width: 2px; border-color: white; }

.center-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.45);
}
.result-panel { min-width: 760px; max-width: 1100px; max-height: 940px; }
.loot-line { margin: 2px 0; }
.loot-affixes { font-size: 18px; color: rgba(255, 255, 255, 0.7); margin-left: 24px; }

/* ---------- Exploração ---------- */
.hud-top-left { position: absolute; left: 24px; top: 18px; }
.hud-top-right { position: absolute; right: 24px; top: 18px; align-items: flex-end; }
.prompt {
    position: absolute;
    bottom: 60px;
    left: 0; right: 0;
    align-items: center;
}
.toasts {
    position: absolute;
    right: 24px;
    top: 90px;
    align-items: flex-end;
}
.toast { margin: 3px 0; padding: 6px 14px; }
.dialogue {
    position: absolute;
    bottom: 40px;
    left: 18%;
    right: 18%;
}
.dialogue-text { font-size: 28px; margin: 6px 0 10px 0; }

/* ---------- Mapa-múndi e título ---------- */
.map-panel {
    position: absolute;
    right: 24px;
    top: 90px;
    width: 560px;
}
.map-hint { position: absolute; left: 24px; bottom: 18px; }
.map-name { position: absolute; left: 0; right: 0; top: 18px; -unity-text-align: middle-center; }
.tier-panel {
    position: absolute;
    left: 24px;
    top: 160px;
    width: 640px;
}
.title-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: space-between;
    padding-top: 40px;
    padding-bottom: 70px;
}
.title-top { align-items: center; }
.map-label {
    position: absolute;
    width: 300px;
    margin-left: -150px;
    -unity-text-align: middle-center;
    font-size: 22px;
    padding: 2px 10px;
}
.map-label.selected { border-color: rgb(255, 205, 70); border-width: 2px; }
.title-logo {
    font-size: 110px;
    -unity-font-style: bold;
    color: rgb(255, 214, 90);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(60, 30, 10);
    margin-bottom: 4px;
}
.title-sub { font-size: 30px; margin-bottom: 30px; }
.title-menu { min-width: 420px; }

/* ---------- Menu de pausa ---------- */
.pause-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(5, 6, 14, 0.7);
    padding: 40px 60px;
}
.tabs { flex-direction: row; margin-bottom: 14px; }
.tab {
    font-size: 30px;
    padding: 6px 22px;
    margin-right: 8px;
    border-radius: 12px;
    background-color: rgba(30, 34, 64, 0.8);
}
.tab.selected { background-color: rgba(255, 205, 70, 0.95); color: rgb(35, 22, 8); -unity-text-outline-width: 0; }
.pause-body { flex-direction: row; flex-grow: 1; }
.column { flex-grow: 1; flex-basis: 0; margin-right: 14px; }
.column-narrow { width: 640px; margin-right: 14px; }
.member-card { flex-grow: 1; flex-basis: 0; margin-right: 14px; }
.stat-line { flex-direction: row; justify-content: space-between; }
.footer { margin-top: 10px; }
.section-title { font-size: 26px; -unity-font-style: bold; margin-top: 8px; margin-bottom: 2px; color: rgb(255, 214, 90); }
